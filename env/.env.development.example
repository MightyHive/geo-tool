# Copy to: env/.env.development (gitignored — do not commit secrets)
# Run: ./scripts/run_web_dev.sh

APP_ENV=development

# React web UI (Vite + FastAPI). OAuth callback: {WEB_PUBLIC_ORIGIN}/api/auth/callback
WEB_PUBLIC_ORIGIN=http://localhost:5173

# Direct Google OAuth for the app UI. Deploy scripts mount AUTH_CLIENT_ID,
# AUTH_CLIENT_SECRET, and AUTH_COOKIE_SECRET from Secret Manager.
# AUTH_REDIRECT_URI=https://YOUR-SERVICE.run.app/api/auth/callback
# GOOGLE_OAUTH_DOMAIN=yourcompany.com
# IAP_HOSTED_DOMAIN=yourcompany.com

# Optional: test IAP locally (no real JWT) — requires IAP_ENABLED=true in secrets or env
# IAP_ENABLED=true
# IAP_AUDIENCE=YOUR_IAP_OAUTH_CLIENT_ID.apps.googleusercontent.com
# IAP_ENFORCE=false
# IAP_DEV_USER_EMAIL=you@yourcompany.com

# Optional GA4 / crawl defaults (same keys as root .env)
# GA4_PROPERTY_ID=
# GA4_AI_CHANNEL_NAMES=
# GOOGLE_APPLICATION_CREDENTIALS=

# Audit completion email via Gmail API (send as your Gmail account)
# 1. Google Cloud Console → enable Gmail API
# 2. Create OAuth client (Desktop app) → download JSON
# 3. Save as env/gmail_client_secrets.json (or set path below)
# 4. One-time: PYTHONPATH=backend:. .venv/bin/python -m api.notify_email
# GMAIL_CLIENT_SECRETS_FILE=env/gmail_client_secrets.json
# GMAIL_TOKEN_PATH=env/.gmail_token.json
# Optional From header (must be your Gmail / send-as alias); blank = authenticated user
# GMAIL_FROM_EMAIL=Your Name <you@gmail.com>
# Optional: use Application Default Credentials instead of desktop OAuth files
# GMAIL_USE_ADC=0
# Optional report link base (defaults to WEB_PUBLIC_ORIGIN):
# REPORT_APP_BASE_URL=http://localhost:5173

# Prompt probe Cloud Run Job
# PROMPT_PROBE_JOB_NAME=geo-audit-prompt-probes
# PROMPT_PROBE_JOB_REGION=europe-west1
# PROMPT_PROBE_JOB_PROJECT=geo-tool-emea-ds

# Optional Redis / Memorystore for slim prompt-performance metrics across Cloud Run
# instances. Graceful no-op when unset. Provision Memorystore for DEV/staging and
# inject REDIS_URL into the Cloud Run service.
# REDIS_URL=redis://10.0.0.3:6379/0
# REDIS_TTL_SEC=300
# SLIM_METRICS_REDIS=1
# Optional: write per-locale slim JSON under the audit dir (GCS FUSE) + CDN base URL
# SLIM_METRICS_GCS_CACHE=0
# SLIM_METRICS_CDN_BASE_URL=https://cdn.example.com/geo-data
