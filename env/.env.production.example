# Copy to: env/.env.production (gitignored)
# Deploy: Cloud Run or your production host

APP_ENV=production

# Required: canonical public URL of the deployed app
WEB_PUBLIC_ORIGIN=https://your-production-host.example.com
DEPLOY_PUBLIC_ORIGIN=https://your-production-host.example.com

# Identity-Aware Proxy — users authenticate at the load balancer; app verifies JWT
IAP_ENABLED=true
IAP_AUDIENCE=YOUR_IAP_OAUTH_CLIENT_ID.apps.googleusercontent.com
IAP_ENFORCE=true
# IAP_HOSTED_DOMAIN=yourcompany.com

# Prefer workload identity or secrets manager in prod; path below is only if you mount a file.
# GOOGLE_APPLICATION_CREDENTIALS=
# GA4_PROPERTY_ID=

# Redis / Memorystore for slim prompt-performance metrics (must be provisioned)
# REDIS_URL=redis://10.x.x.x:6379/0
# REDIS_TTL_SEC=300
# SLIM_METRICS_REDIS=1
# SLIM_METRICS_GCS_CACHE=0
# SLIM_METRICS_CDN_BASE_URL=

# Audit completion email — local/dev uses Gmail API (see env/.env.development.example).
# SendGrid secrets below are unused by the notification path for now.
# SENDGRID_API_KEY=  # unused (legacy deploy secret name)
# REPORT_APP_BASE_URL defaults to WEB_PUBLIC_ORIGIN when unset
