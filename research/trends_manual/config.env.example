# Copy to config.env and pass: ./run_manual_trends.sh --config config.env --print-checklist

QUERY_TERM="good food"

# Dates default from shared.env (2022-06-01 → 2026-05-31)
# START_DATE=2022-06-01
# END_DATE=2026-05-31

TRENDS_GEO=GB
TRENDS_HL=en-GB

# Optional explicit BQ table (otherwise derived from QUERY_TERM slug)
# BQ_TRENDS_WEEKLY_TABLE=geo-tool-emea-ds.geo_tool.google_trends_weekly_my_term

# Optional data directory override
# TRENDS_DATA_DIR=/path/to/data/my_term_20220601
